# cp .env.example .env 후 실제 값 입력. .env 는 커밋되지 않음

# ── RDS ─────────────────────────────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=briefing_v2

# ── keyword-summary Lambda Function URL ─────
# 비어 있으면 /summary 만 503, 나머지 엔드포인트는 정상
SUMMARY_LAMBDA_URL=

# ── 서버 ────────────────────────────────────
# EC2 에서 80 을 쓰려면 sudo 필요. 막히면 3000
PORT=80
